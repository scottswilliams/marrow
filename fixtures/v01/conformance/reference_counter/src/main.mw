// A durable counter CLI with checked entry references for field updates.
// Direct paths support optional reads, creation, replacement, and deletion.

resource Counter {
    required value: int
    label: string
}

store ^counters[name: string]: Counter

pub fn set(name: string, v: int) {
    transaction {
        ^counters[name] = Counter(value: v)
    }
}

pub fn get(name: string): int? {
    return ^counters[name].value
}

pub fn bump(name: string) {
    transaction {
        ref p = ^counters[name] else {
            ^counters[name] = Counter(value: 1)
            return
        }
        p.value = p.value + 1
    }
}

pub fn label(name: string, text: string) {
    transaction {
        ref p = ^counters[name] else {
            return
        }
        p.label = text
    }
}

pub fn present(name: string): bool {
    return exists(^counters[name])
}

pub fn remove(name: string) {
    transaction {
        delete ^counters[name]
    }
}
