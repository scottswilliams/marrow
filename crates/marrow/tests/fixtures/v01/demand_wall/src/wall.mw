module wall

// One export whose per-export demand sentence names every field of three roots,
// so its `--demand` line is far wider than any line of the default summary.

resource Alpha {
    first: int
    second: int
    third: int
    fourth: int
    fifth: int
    sixth: int
    seventh: int
    eighth: int
}

store ^alpha[id: int]: Alpha

resource Beta {
    first: int
    second: int
    third: int
    fourth: int
    fifth: int
    sixth: int
    seventh: int
    eighth: int
}

store ^beta[id: int]: Beta

resource Gamma {
    first: int
    second: int
    third: int
    fourth: int
    fifth: int
    sixth: int
    seventh: int
    eighth: int
}

store ^gamma[id: int]: Gamma

pub fn touchAll(id: int) {
    transaction {
        place a = ^alpha[id]
        if exists(a) {
            a.first = (a.first ?? 0) + 1
            a.second = (a.second ?? 0) + 1
            a.third = (a.third ?? 0) + 1
            a.fourth = (a.fourth ?? 0) + 1
            a.fifth = (a.fifth ?? 0) + 1
            a.sixth = (a.sixth ?? 0) + 1
            a.seventh = (a.seventh ?? 0) + 1
            a.eighth = (a.eighth ?? 0) + 1
        }
        place b = ^beta[id]
        if exists(b) {
            b.first = (b.first ?? 0) + 1
            b.second = (b.second ?? 0) + 1
            b.third = (b.third ?? 0) + 1
            b.fourth = (b.fourth ?? 0) + 1
            b.fifth = (b.fifth ?? 0) + 1
            b.sixth = (b.sixth ?? 0) + 1
            b.seventh = (b.seventh ?? 0) + 1
            b.eighth = (b.eighth ?? 0) + 1
        }
        place g = ^gamma[id]
        if exists(g) {
            g.first = (g.first ?? 0) + 1
            g.second = (g.second ?? 0) + 1
            g.third = (g.third ?? 0) + 1
            g.fourth = (g.fourth ?? 0) + 1
            g.fifth = (g.fifth ?? 0) + 1
            g.sixth = (g.sixth ?? 0) + 1
            g.seventh = (g.seventh ?? 0) + 1
            g.eighth = (g.eighth ?? 0) + 1
        }
    }
}
