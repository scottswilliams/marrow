resource Counter {
    required value: int
}

store ^idseq[name: string]: Counter

resource Book {
    required title: string
}

store ^books[id: int]: Book

pub fn createBook(title: string): int {
    transaction {
        const next = (^idseq["book"].value ?? 0) + 1
        ^idseq["book"] = Counter(value: next)
        ^books[next] = Book(title: title)
        return next
    }
}

pub fn titleOf(id: int): string? {
    return ^books[id].title
}

pub fn seqValue(): int? {
    return ^idseq["book"].value
}
