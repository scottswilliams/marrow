resource Account {
    required balance: int
    name: string
}

store ^accounts[id: int]: Account

resource Event {
    required kind: int
}

store ^events[id: int]: Event

pub fn alpha(id: int) {
    transaction {
        place account = ^accounts[id]
        const bal = account.balance ?? 0
        const nm = account.name ?? ""
        if exists(account) {
            account.balance = bal + 1
            account.name = nm
        }
        ^events[id] = Event(kind: bal)
    }
}

pub fn beta(id: int) {
    transaction {
        place account = ^accounts[id]
        const bal = account.balance ?? 0
        const nm = account.name ?? ""
        if exists(account) {
            account.balance = bal + 1
            account.name = nm
        }
        ^events[id] = Event(kind: bal)
    }
}

pub fn accountBalance(id: int): int {
    return ^accounts[id].balance ?? 0
}

pub fn double(n: int): int {
    return n * 2
}
